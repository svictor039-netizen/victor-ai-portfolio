# Fill with the confirmed public origin before publication. No trailing path.
PUBLIC_SITE_URL=
# Keep false until placeholders and contact delivery have been replaced.
PUBLIC_ALLOW_INDEXING=false

# Public configuration only. The endpoint is the separately deployed Worker's /api/leads URL.
PUBLIC_LEAD_ENDPOINT=
# AI Consultant endpoint (Worker's /api/consult URL). If empty, consultant shows fallback UI.
PUBLIC_CONSULT_ENDPOINT=
PUBLIC_TURNSTILE_SITE_KEY=
# Set true only after the data-processing notice has been confirmed and completed.
PUBLIC_LEAD_CONSENT_CONFIRMED=false

# Back Office server-side auth (scrypt)
ADMIN_USERNAME=admin
# Generate scrypt hash: node -e "const {scryptSync,randomBytes}=require('crypto');const s=randomBytes(32);console.log(s.toString('hex')+':'+scryptSync('your-password',s,64,{N:32768,r:8,p:1,maxmem:64*1024*1024}).toString('hex'))"
ADMIN_PASSWORD_HASH=

# Ingestion endpoint Bearer token (shared with Worker)
INGEST_TOKEN=

# Worker ingestion URL (Back Office ingestion endpoint)
BACKOFFICE_INGEST_URL=

# SQLite database path.
# Local/dev default: ./data/victor.db
# Production: mount a persistent volume at this path (e.g. /mnt/data/victor.db).
DATABASE_PATH=./data/victor.db

# Lead notification recipient email (required; Worker returns 503 if empty).
LEAD_RECIPIENT=vslpk@inbox.ru
