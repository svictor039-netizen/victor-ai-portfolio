---
interface Props { label?: string; }
const { label = 'Принцип работы: задача, система, результат' } = Astro.props;
---
      <aside class="hero-diagram" aria-label={label}>
        <div class="hero-diagram-media">
          <img
            src="/images/hero-principle-victor-ai.png"
            alt="Виктор — от задачи к работающей AI-системе и результату"
            width="600"
            height="450"
            loading="eager"
            decoding="async"
          />
        </div>
      </aside>
