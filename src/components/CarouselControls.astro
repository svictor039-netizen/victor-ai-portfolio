---
interface Props { label: string; }
const { label } = Astro.props;
---
<div class="carousel-controls" aria-label={`Управление каруселью «${label}»`}>
  <button class="carousel-arrow" type="button" data-carousel-prev aria-label={`Назад: ${label}`} disabled>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
  </button>
  <button class="carousel-arrow" type="button" data-carousel-next aria-label={`Вперёд: ${label}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
  </button>
</div>

<script>
  function initializeCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
      if (carousel.dataset.carouselReady === 'true') return;
      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (!track || !previous || !next) return;

      carousel.dataset.carouselReady = 'true';
      let frame = 0;
      let animation = 0;
      const update = () => {
        const end = Math.max(0, track.scrollWidth - track.clientWidth);
        previous.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= end - 2;
      };
      const scheduleUpdate = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      };
      const move = (direction: -1 | 1) => {
        const item = track.querySelector<HTMLElement>('.project-card, .agent-card, .service-flip');
        const styles = getComputedStyle(track);
        const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
        const step = item ? item.getBoundingClientRect().width + gap : track.clientWidth * .85;
        const current = Math.round(track.scrollLeft / step);
        const end = Math.max(0, track.scrollWidth - track.clientWidth);
        const target = Math.min(end, Math.max(0, (current + direction) * step));

        cancelAnimationFrame(animation);
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          track.scrollLeft = target;
          scheduleUpdate();
          return;
        }

        const start = track.scrollLeft;
        const startedAt = performance.now();
        const duration = 320;
        track.dataset.carouselAnimating = 'true';
        const tick = (now: number) => {
          const progress = Math.min(1, (now - startedAt) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          track.scrollLeft = start + (target - start) * eased;
          if (progress < 1) {
            animation = requestAnimationFrame(tick);
          } else {
            delete track.dataset.carouselAnimating;
            track.scrollLeft = target;
            scheduleUpdate();
          }
        };
        animation = requestAnimationFrame(tick);
      };

      const stopAnimation = () => {
        cancelAnimationFrame(animation);
        delete track.dataset.carouselAnimating;
      };

      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      track.addEventListener('pointerdown', stopAnimation, { passive: true });
      track.addEventListener('wheel', stopAnimation, { passive: true });
      track.addEventListener('keydown', (event) => {
        if (event.target !== track) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          move(-1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          move(1);
        }
      });
      track.addEventListener('scroll', scheduleUpdate, { passive: true });
      new ResizeObserver(scheduleUpdate).observe(track);
      update();
    });
  }

  initializeCarousels();
  document.addEventListener('astro:page-load', initializeCarousels);
</script>
