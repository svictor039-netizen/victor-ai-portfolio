---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GradientButton from '../../components/kokonutui/gradient-button';
import { projects, getProject } from '../../data/projects';

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug } }));
}

const project = getProject(Astro.params.slug);
if (!project) throw new Error(`Unknown project: ${Astro.params.slug}`);
---
<BaseLayout title={project.seoTitle} description={project.seoDescription} noindex={project.incomplete} ogImage={project.image?.src}>
  <Header />
  <main id="main" class="container case-page">
    <p class="eyebrow"><a href="/projects/">Проекты</a> / кейс</p>
    <h1>{project.title}</h1>
    <p class="case-lead">{project.short}</p>
    <div class="card-meta case-meta"><span>{project.type}</span><span class="status">{project.status}</span></div>
    {project.image
      ? <figure class="case-figure"><img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} decoding="async" /><figcaption>{project.image.caption ?? project.image.alt}</figcaption></figure>
      : <p class="needs-evidence">{project.placeholderCaption ?? 'Реальный screenshot интерфейса пока отсутствует. Вымышленный экран не добавлялся.'}</p>
    }
    {project.visualNote && (
      <section class="case-section" aria-labelledby={`${project.slug}-visual`}>
        <h2 id={`${project.slug}-visual`}>О показанном интерфейсе</h2>
        <ul class="case-note-list">{project.visualNote.map(item => <li>{item}</li>)}</ul>
      </section>
    )}
    {project.sections.map((section, index) => (
      <section class="case-section" aria-labelledby={`${project.slug}-s${index}`}>
        <h2 id={`${project.slug}-s${index}`}>{section.title}</h2>
        <p>{section.body}</p>
        {section.needsEvidence && <p class="needs-evidence">Блок требует дополнения: новых фактов нет, вымышленный текст не добавлялся.</p>}
      </section>
    ))}
    <section class="case-section" aria-labelledby={`${project.slug}-cta`}>
      <h2 id={`${project.slug}-cta`}>Что дальше</h2>
      <div class="project-actions">
        <GradientButton label="Обсудить похожую задачу" href="/#contact" />
        {project.liveUrl && <a class="button" href={project.liveUrl} rel="noopener noreferrer" target="_blank">Открыть проект <span aria-hidden="true">↗</span></a>}
        <a class="text-link" href="/projects/">Ко всем проектам <span aria-hidden="true">←</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
