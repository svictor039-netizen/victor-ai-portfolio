---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AdminAuthGuard } from '../../components/admin/AdminAuthGuard';
import { AdminSidebar } from '../../components/admin/AdminSidebar';
import { CatchJobPanel } from '../../components/admin/CatchJobPanel';
import { getSessionToken, validateSession } from '../../lib/auth';

const token = getSessionToken(Astro.request);
const session = token ? validateSession(token) : null;
if (!session) {
  return Astro.redirect('/admin/login/');
}
---
<AdminLayout title="Ловец заказов">
  <AdminAuthGuard client:only="react">
    <div class="flex min-h-screen">
      <AdminSidebar client:load />
      <div class="flex-1 min-w-0 p-4 pt-16 sm:p-6 sm:pt-16 lg:p-8">
        <h1 class="text-2xl font-semibold heading-gradient-full">Ловец заказов</h1>
        <p class="text-sm text-muted-foreground mt-1 mb-6">Catch_Job_4Me · ручная проверка @job_developer и @kwork_birzha через Telegram Public MCP, только чтение</p>
        <CatchJobPanel client:load />
      </div>
    </div>
  </AdminAuthGuard>
</AdminLayout>
