---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AdminAuthGuard } from '../../components/admin/AdminAuthGuard';
import { AdminSidebar } from '../../components/admin/AdminSidebar';
import { StatsCards } from '../../components/admin/StatsCards';
import { LeadsTable } from '../../components/admin/LeadsTable';
import { getSessionToken, validateSession } from '../../lib/auth';

const token = getSessionToken(Astro.request);
const session = token ? validateSession(token) : null;
if (!session) {
  return Astro.redirect('/admin/login/');
}
---
<AdminLayout title="Dashboard">
  <AdminAuthGuard client:only="react">
    <div class="flex min-h-screen">
      <AdminSidebar client:load />
      <div class="flex-1 p-6 lg:p-8 space-y-6">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-semibold">Dashboard</h1>
          <div class="text-sm text-muted-foreground">{new Date().toLocaleDateString('ru-RU')}</div>
        </div>
        <StatsCards client:load />
        <div class="bg-surface border border-border rounded-xl p-5">
          <h2 class="text-lg font-medium mb-3">Последние лиды</h2>
          <LeadsTable client:load />
        </div>
      </div>
    </div>
  </AdminAuthGuard>
</AdminLayout>
